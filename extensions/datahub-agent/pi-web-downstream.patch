+}
+.message h3 {
+  margin: 0;
+  font-size: 15px;
+}
+.message p,
+.message small {
+  font-size: 12px;
+  color: var(--text-muted);
+}
+.message small {
+  display: block;
+  margin-top: 8px;
+}
+.dataset {
+  overflow-wrap: anywhere;
+}
+.message button,
+.header button {
+  border: 1px solid var(--border);
+  border-radius: 6px;
+  padding: 6px 10px;
+  background: var(--bg);
+  color: var(--text);
