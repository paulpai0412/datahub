+type View = {
+  request: CatalogRequest;
+  tab: CatalogTab;
+  title: string;
+  filter: string;
+  graph: boolean;
+  lineagePages: CatalogResult[];
+  lineageView: CatalogLineageView;
+  scroll: number;
