+      return false;
+    const entries = Object.entries(coverage.counts);
+    if (
+      entries.some(
+        ([key, count]) =>
+          ![
+            "BOUND_SELECTED_WRITE",
+            "OUTSIDE_SELECTED_PYTHON_ENTRYPOINT",
+            "UNRESOLVED_SELECTED_SOURCE",
