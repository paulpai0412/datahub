+          (t.id !== "lineage" || supportsLineage(e.type)),
+  );
+  return (
+    <div
+      ref={root}
+      className={`${s.surface} ${s.root}`}
+      role={modal ? "dialog" : "complementary"}
+      aria-modal={modal || undefined}
+      aria-label="DataHub 資產詳情"
+      onKeyDown={(event) => {
+        if (event.key === "Escape") {
+          event.stopPropagation();
