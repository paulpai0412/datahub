+  }, [view.request, view.scroll]); // Tab/filter-only changes must not restart a read.
+  function navigate(next: CatalogSelection, graph = false) {
+    setHistory((h) => [
+      ...h,
+      { ...view, scroll: body.current?.scrollTop ?? 0 },
+    ]);
+    setView({
+      ...next,
+      filter: next.request.fieldQuery ?? "",
