+    const outputs = graphNodes.flatMap((node) =>
+      (node.fields ?? []).filter((field) => field.origin),
+    );
+    if (
+      outputs.length !== expected ||
+      outputs.filter((field) => field.origin?.classification === "UNRESOLVED")
