+        urn: Type.Optional(Type.String({ minLength: 8, maxLength: 2048 })),
+        relatedTo: Type.Optional(
+          Type.String({ minLength: 8, maxLength: 2048 }),
+        ),
+        browsePath: Type.Optional(
+          Type.Array(Type.String({ minLength: 1, maxLength: 2048 }), {
+            minItems: 1,
+            maxItems: 20,
