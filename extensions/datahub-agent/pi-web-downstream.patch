+        !origin.generationRefs.every(
+          (id: unknown) =>
+            typeof id === "string" && Object.hasOwn(generations, id),
+        ) ||
+        !Array.isArray(origin.operations) ||
+        !origin.operations.every((name: unknown) => typeof name === "string") ||
