+        if (
+          !candidate.locations.every(
+            (point: unknown) =>
+              record(point) &&
+              typeof point.file === "number" &&
+              Number.isSafeInteger(point.file) &&
+              point.file >= 0 &&
+              point.file < fileCount &&
+              typeof point.line === "number" &&
+              Number.isSafeInteger(point.line) &&
+              point.line > 0 &&
