+export function DataHubCatalogDetail({
+  selection,
+  onClose,
+  onQuote,
+}: {
+  selection: CatalogSelection;
+  onClose: () => void;
+  onQuote: (reference: CatalogReference) => void;
+}) {
+  const [view, setView] = useState<View>({
+    ...selection,
+    filter: selection.request.fieldQuery ?? "",
