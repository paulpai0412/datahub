+}
+.panel {
+  height: 100%;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+  background: var(--bg);
+  color: var(--text);
+}
+.header {
+  display: flex;
+  align-items: center;
+  gap: 8px;
