diff --git a/app/api/mcp-config/route.test.mjs b/app/api/mcp-config/route.test.mjs
new file mode 100644
index 0000000..2a9dc84
--- /dev/null
+++ b/app/api/mcp-config/route.test.mjs
@@ -0,0 +1,51 @@
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import test from "node:test";
+import { createJiti } from "jiti";
+const root = fileURLToPath(new URL("../../..", import.meta.url));
+const { GET, PUT } = await createJiti(import.meta.url, {
+  alias: { "@": root },
+}).import("./route.ts");
+
+test("MCP config API bounds input and never echoes secrets on failures (route unit, not auth E2E)", async () => {
+  const previous = process.env.PI_CODING_AGENT_DIR;
+  const home = mkdtempSync(join(tmpdir(), "pi-mcp-api-"));
+  process.env.PI_CODING_AGENT_DIR = home;
+  const put = (text) =>
+    PUT(
+      new Request("http://localhost/api/mcp-config", {
+        method: "PUT",
+        body: text,
+      }),
+    );
+  try {
+    const response = await GET();
+    assert.equal(response.status, 200);
+    assert.equal(response.headers.get("cache-control"), "no-store");
+    const before = await response.json();
+    const body = JSON.stringify({
+      revision: before.revision,
+      config: { mcpServers: {} },
+    });
+    assert.equal((await put(body)).status, 200);
+    assert.equal((await put(body)).status, 409);
+    for (const input of [
+      "secret-invalid-json",
+      "null",
+      '{"config":"synthetic-secret"}',
+    ]) {
+      const denied = await put(input);
+      assert.equal(denied.status, 400);
+      assert.equal(await denied.text(), '{"error":"invalid_mcp_config"}');
+    }
+    const oversized = await put("x".repeat(1024 * 1024 + 1));
+    assert.equal(oversized.status, 413);
+  } finally {
+    if (previous === undefined) delete process.env.PI_CODING_AGENT_DIR;
+    else process.env.PI_CODING_AGENT_DIR = previous;
+    rmSync(home, { recursive: true, force: true });
+  }
+});
diff --git a/app/api/mcp-config/route.ts b/app/api/mcp-config/route.ts
new file mode 100644
index 0000000..fc5ba6f
--- /dev/null
+++ b/app/api/mcp-config/route.ts
@@ -0,0 +1,65 @@
+import { NextResponse } from "next/server";
+import {
+  MCP_CONFIG_MAX_BYTES,
+  readMcpConfig,
+  writeMcpConfig,
+} from "@/lib/mcp-config-store";
+
+export const dynamic = "force-dynamic";
+const headers = { "Cache-Control": "no-store" };
+
+// Authentication/Origin checks are shared with other Pi APIs in proxy.ts.
+// Paths and ownership come from this isolated runtime, never the request body.
+export async function GET() {
+  try {
+    return NextResponse.json(readMcpConfig(), { headers });
+  } catch {
+    return NextResponse.json(
+      { error: "mcp_config_unavailable" },
+      { status: 500, headers },
+    );
+  }
+}
+
+export async function PUT(request: Request) {
+  const reader = request.body?.getReader();
+  if (!reader)
+    return NextResponse.json(
+      { error: "invalid_mcp_config" },
+      { status: 400, headers },
+    );
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      size += value.byteLength;
+      if (size > MCP_CONFIG_MAX_BYTES) {
+        await reader.cancel();
+        return NextResponse.json(
+          { error: "mcp_config_too_large" },
+          { status: 413, headers },
+        );
+      }
+      chunks.push(value);
+    }
+    const body = JSON.parse(Buffer.concat(chunks).toString("utf8"));
+    const saved = writeMcpConfig(body?.config, body?.revision);
+    return NextResponse.json(saved, { headers });
+  } catch (error) {
+    const message = error instanceof Error ? error.message : "";
+    const status =
+      message === "mcp_config_conflict"
+        ? 409
+        : message === "mcp_config_unavailable"
+          ? 500
+          : 400;
+    return NextResponse.json(
+      { error: status === 400 ? "invalid_mcp_config" : message },
+      { status, headers },
+    );
+  } finally {
+    reader.releaseLock();
+  }
+}
diff --git a/app/datahub.css b/app/datahub.css
new file mode 100644
index 0000000..0ae3381
--- /dev/null
+++ b/app/datahub.css
@@ -0,0 +1,204 @@
+/* DataHub v1.7.0.1 tokens; scoped to the presentation-only embedded build. */
+@font-face {
+ font-family: "DataHub Mulish";
+ src: url("./fonts/Mulish-Regular.ttf") format("truetype");
+ font-weight: 400;
+ font-display: swap;
+}
+@font-face {
+ font-family: "DataHub Mulish";
+ src: url("./fonts/Mulish-SemiBold.ttf") format("truetype");
+ font-weight: 600 900;
+ font-display: swap;
+}
+html[data-datahub="true"] {
+ color-scheme: light;
+ --bg: #fff;
+ --bg-panel: #fff;
+ --bg-hover: #f5f6fa;
+ --bg-selected: #ece9f8;
+ --border: #ececec;
+ --text: #374066;
+ --text-muted: #5f6685;
+ --text-dim: #5f6685;
+ --accent: #533fd1;
+ --accent-hover: #5c3fd1;
+ --accent-contrast: #fff;
+ --user-bg: #f5f6fa;
+ --assistant-bg: #fff;
+ --tool-bg: #f9fafc;
+ --bg-subtle: #f9fafc;
+}
+html[data-datahub="true"] body {
+ font-family: "DataHub Mulish", sans-serif;
+ font-size: 14px;
+}
+.datahub-header {
+ height: 56px;
+ padding: 0 20px;
+ display: flex;
+ align-items: center;
+ justify-content: space-between;
+ gap: 12px;
+ border-bottom: 1px solid var(--border);
+ background: var(--bg);
+}
+.datahub-header h1 {
+ font-size: 22px;
+ font-weight: 600;
+}
+.datahub-header > div {
+ display: flex;
+ gap: 8px;
+}
+.datahub-header button,
+.datahub-drawer-close {
+ min-height: 36px;
+ padding: 6px 12px;
+ color: var(--text);
+ background: var(--bg);
+ border: 1px solid var(--border);
+ border-radius: 6px;
+ cursor: pointer;
+}
+.datahub-header button:hover,
+.datahub-drawer-close:hover {
+ background: var(--bg-selected);
+ border-color: var(--accent);
+}
+html[data-datahub="true"] button:focus-visible {
+ outline: 2px solid var(--accent);
+ outline-offset: -2px;
+}
+.datahub-drawer-close {
+ padding: 0;
+ min-width: 28px;
+ min-height: 32px;
+ font-size: 20px;
+}
+.datahub-history-toggle {
+ width: 84px !important;
+ font-size: 13px;
+}
+.datahub-details-toggle {
+ width: 86px !important;
+ gap: 6px;
+ font-size: 13px;
+}
+/* Keep the sidebar mounted: it owns polling, project/session restoration and
+   portaled directory pickers. It is a non-modal drawer, not a second navigation. */
+html[data-datahub="true"] .sidebar-container {
+ position: fixed !important;
+ top: 56px;
+ bottom: 0;
+ left: 0;
+ height: auto;
+ width: min(var(--sidebar-width, 300px), calc(100vw - 16px));
+ min-width: 0;
+ max-width: none;
+ overflow: hidden;
+ transition: transform 0.16s ease;
+}
+html[data-datahub="true"] .sidebar-container > * {
+ width: 100%;
+ min-width: 0;
+}
+html[data-datahub="true"] .sidebar-container.sidebar-open {
+ transform: translateX(0);
+ box-shadow: 0 4px 12px rgba(9, 1, 61, 0.12);
+}
+html[data-datahub="true"] .sidebar-container.sidebar-closed {
+ transform: translateX(-100%);
+ visibility: hidden;
+ pointer-events: none;
+}
+html[data-datahub="true"] .sidebar-overlay-backdrop {
+ display: block !important;
+ inset: 56px 0 0 !important;
+}
+/* Drawer resize uses the original keyboard/pointer resizer and stored width. */
+html[data-datahub="true"] .sidebar-resize-handle {
+ position: fixed;
+ top: 56px;
+ bottom: 0;
+ left: var(--sidebar-width, 260px);
+ z-index: 201;
+}
+.datahub-welcome {
+ margin: 0 auto 36px;
+ padding: 24px 32px;
+ max-width: 820px;
+}
+.datahub-welcome h2 {
+ font-size: 28px;
+ font-weight: 600;
+ line-height: 1.35;
+ margin-bottom: 12px;
+}
+.datahub-welcome p {
+ color: var(--text-muted);
+ text-wrap: pretty;
+}
+html[data-datahub="true"] .datahub-get-started {
+ inset: 0 !important;
+ padding: 36px;
+ align-items: center !important;
+ justify-content: center;
+}
+.datahub-get-started > svg {
+ display: none;
+}
+.datahub-attribution {
+ color: var(--text-muted);
+ font-size: 12px;
+ margin-top: 16px;
+}
+/* Existing settings components and their portals remain intact; only the
+   surface becomes a workspace page. Source/approval controls are NOT hosted here. */
+html[data-datahub="true"] .settings-dialog-backdrop {
+ top: 56px;
+ padding: 0;
+ background: var(--bg);
+}
+html[data-datahub="true"] .settings-dialog-surface {
+ width: 100%;
+ height: 100%;
+ max-width: none;
+ max-height: none;
+ border: 0;
+ border-radius: 0;
+ box-shadow: none;
+}
+@media (max-width: 959px) {
+ html[data-datahub="true"] .right-panel-container {
+  top: 56px;
+  height: calc(var(--app-viewport-height, 100dvh) - 56px);
+ }
+ html[data-datahub="true"] .right-panel-overlay-backdrop {
+  top: 56px;
+ }
+}
+@media (max-width: 640px) {
+ .datahub-header {
+  padding-inline: 12px;
+ }
+ .datahub-header h1 {
+  font-size: 20px;
+ }
+ .datahub-header button {
+  min-height: 44px;
+  padding-inline: 10px;
+ }
+ .datahub-welcome {
+  margin-bottom: 12px;
+  padding: 16px 24px;
+ }
+ .datahub-welcome h2 {
+  font-size: 22px;
+ }
+}
+@media (prefers-reduced-motion: reduce) {
+ html[data-datahub="true"] .sidebar-container {
+  transition: none;
+ }
+}
