namespace com.ekop.agent

/** Permanent one-attempt admission for the enclosing reviewed Decision.
 * Presence consumes that Decision's consent; it does not prove a target request
 * was sent or succeeded. Never clear this marker on failure, close or retry.
 * Target ACL, freshness, conditional writes and reconciliation remain separate.
 */
record EkopAgentPublicationAttempt {
  /** Generated by the trusted Host, never supplied by the model/browser. */
  attemptId: string

  /** Host time when admission was prepared; not target execution time. */
  claimedAt: long
}
