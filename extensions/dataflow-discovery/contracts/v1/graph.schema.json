{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["nodes", "edges", "coverage", "findings"],
  "properties": {
    "nodes": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/edge"}},
    "coverage": {"type": "array", "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["path", "state", "reason"], "properties": {"path": {"$ref": "#/$defs/text"}, "state": {"enum": ["analyzed", "unsupported"]}, "reason": {"$ref": "#/$defs/text"}}}},
    "findings": {"type": "array", "maxItems": 10000, "items": {"type": "object", "additionalProperties": false, "required": ["code", "evidence"], "properties": {"code": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$", "maxLength": 128}, "evidence": {"$ref": "#/$defs/evidenceList"}}}},
    "legacyAnalysis": {"type": "object"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["path", "fileSha256", "startLine", "endLine"], "properties": {
      "path": {"$ref": "#/$defs/text"}, "fileSha256": {"$ref": "#/$defs/digest"}, "startLine": {"type": "integer", "minimum": 1}, "endLine": {"type": "integer", "minimum": 1}, "pointer": {"type": "string", "maxLength": 4096, "pattern": "^(|/.*)$"}
    }},
    "evidenceList": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/evidence"}},
    "field": {"type": "object", "additionalProperties": false, "required": ["path", "nativeType"], "properties": {"path": {"$ref": "#/$defs/text"}, "nativeType": {"$ref": "#/$defs/text"}, "nullable": {"type": "boolean"}}},
    "node": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "localId", "name", "evidence"], "properties": {
      "id": {"type": "string", "pattern": "^node_[0-9a-f]{64}$"}, "kind": {"enum": ["asset", "operation", "port"]},
      "localId": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}, "assetType": {"$ref": "#/$defs/text"},
      "owner": {"type": "string", "pattern": "^node_[0-9a-f]{64}$"}, "direction": {"enum": ["input", "output", "inout"]},
      "fields": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/field"}}, "operationType": {"$ref": "#/$defs/text"},
      "expressionSha256": {"$ref": "#/$defs/digest"}, "evidence": {"$ref": "#/$defs/evidenceList"}
    }, "allOf": [
      {"if": {"properties": {"kind": {"const": "asset"}}}, "then": {"required": ["assetType"], "not": {"anyOf": [{"required": ["owner"]}, {"required": ["direction"]}, {"required": ["fields"]}, {"required": ["operationType"]}, {"required": ["expressionSha256"]}]}}},
      {"if": {"properties": {"kind": {"const": "port"}}}, "then": {"required": ["owner", "direction", "fields"], "not": {"anyOf": [{"required": ["assetType"]}, {"required": ["operationType"]}, {"required": ["expressionSha256"]}]}}},
      {"if": {"properties": {"kind": {"const": "operation"}}}, "then": {"required": ["operationType"], "not": {"anyOf": [{"required": ["assetType"]}, {"required": ["owner"]}, {"required": ["direction"]}, {"required": ["fields"]}]}}}
    ]},
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["node"], "properties": {"node": {"type": "string", "pattern": "^node_[0-9a-f]{64}$"}, "field": {"$ref": "#/$defs/text"}}},
    "edge": {"type": "object", "additionalProperties": false, "required": ["kind", "sources", "target", "evidence"], "properties": {
      "kind": {"enum": ["reads", "writes", "calls", "contains", "depends_on", "value_dependency", "condition_dependency"]},
      "sources": {"type": "array", "minItems": 1, "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/endpoint"}},
      "target": {"$ref": "#/$defs/endpoint"}, "evidence": {"$ref": "#/$defs/evidenceList"}
    }}
  }
}
